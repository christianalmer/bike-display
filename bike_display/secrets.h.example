// Copy to secrets.h (gitignored) and fill in real values.
// The display tries these networks in order at boot (and again after a
// restart) until one connects — list home first, then other locations,
// then your phone's personal hotspot as the anywhere-fallback.
#ifndef SECRETS_H
#define SECRETS_H

struct WifiNetwork { const char* ssid; const char* pass; };

static const WifiNetwork WIFI_NETWORKS[] = {
  {"your-wifi-ssid", "your-wifi-password"},
  // {"other-place-ssid", "other-place-password"},
  // {"your-phone-hotspot", "hotspot-password"},
};

// Your Bay Wheels station. Find the id by searching your station's name in
// https://gbfs.baywheels.com/gbfs/en/station_information.json
#define SECRET_STATION_ID    "00000000-0000-0000-0000-000000000000"
#define SECRET_STATION_LABEL "My Station"  // shown on the glass when data is stale

#endif
